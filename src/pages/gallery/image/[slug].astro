---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import galleryIndex from "../../../../public/gallery/index.json";
import { galleryDetailPath } from "../../../lib/galleryUrls";
import { imageNeighbors } from "../../../lib/galleryNavigation";

export function getStaticPaths() {
  const seen = new Set<string>();
  return galleryIndex.images.map((image) => {
    const path = galleryDetailPath(image.src);
    if (seen.has(path))
      throw new Error(`Duplicate gallery detail route: ${path}`);
    seen.add(path);
    return { params: { slug: path.split("/")[3] }, props: { image } };
  });
}

const { image } = Astro.props as {
  image: (typeof galleryIndex.images)[number];
};
const canonical = new URL(galleryDetailPath(image.src), Astro.site).href;
const neighbors = imageNeighbors(galleryIndex.images, image.src);
---

<BaseLayout
  title={`${image.title} | Gallery | urandom.io`}
  description={image.description ||
    `${image.title} — gallery artwork at urandom.io`}
  favicon="🎨"
  canonical={canonical}
>
  <main class="min-h-screen px-5 py-8 sm:px-8 sm:py-12">
    <div class="mx-auto max-w-5xl">
      <nav
        aria-label="Gallery"
        class="mb-8 flex items-center justify-between gap-4 text-sm"
      >
        <a
          href="/gallery"
          class="text-purple-300 hover:text-purple-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400"
          >← Gallery</a
        >
        <span class="text-zinc-500">{image.date}</span>
      </nav>
      {
        image.mediaType !== "video" && (
          <nav
            aria-label="Image navigation"
            class="mb-5 flex items-center justify-between gap-3 text-sm"
          >
            {neighbors.previous ? (
              <a
                aria-label="Previous image"
                rel="prev"
                href={galleryDetailPath(neighbors.previous)}
                class="rounded-lg border border-purple-500/60 px-4 py-3 text-purple-200 hover:bg-purple-500/20 focus-visible:outline-2 focus-visible:outline-purple-400"
              >
                ← Previous image
              </a>
            ) : (
              <span class="text-zinc-600">First image</span>
            )}
            {neighbors.next ? (
              <a
                aria-label="Next image"
                rel="next"
                href={galleryDetailPath(neighbors.next)}
                class="rounded-lg border border-purple-500/60 px-4 py-3 text-purple-200 hover:bg-purple-500/20 focus-visible:outline-2 focus-visible:outline-purple-400"
              >
                Next image →
              </a>
            ) : (
              <span class="text-zinc-600">Last image</span>
            )}
          </nav>
        )
      }
      <article
        class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(16rem,1fr)] lg:items-start"
      >
        <div
          class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/50"
        >
          {
            image.mediaType === "video" ? (
              <video
                src={image.src}
                poster={image.thumb ?? image.src}
                controls
                playsinline
                preload="metadata"
                aria-label={image.title}
                class="block h-auto max-h-[80vh] w-full object-contain"
              />
            ) : (
              <img
                src={image.src}
                alt={image.title}
                class="block h-auto max-h-[80vh] w-full object-contain"
              />
            )
          }
        </div>
        <div class="min-w-0">
          <p class="mb-3 text-xs tracking-widest text-purple-400 uppercase">
            Gallery / {image.mediaType === "video" ? "motion" : "image"}
          </p>
          <h1
            class="mb-4 text-2xl font-light break-words text-zinc-100 sm:text-3xl"
          >
            {image.title}
          </h1>
          {
            image.description && (
              <p class="mb-5 text-sm leading-7 text-zinc-400">
                {image.description}
              </p>
            )
          }
          <p class="mb-6 text-xs text-zinc-500">{image.model} · {image.date}</p>
          <div class="mb-5 flex flex-wrap gap-2">
            {
              image.tags.map((tag) => (
                <a
                  href={`/gallery?tag=${encodeURIComponent(tag)}`}
                  class="rounded-full border border-zinc-800 px-2 py-1 text-xs text-zinc-400 hover:border-purple-500 hover:text-purple-300"
                >
                  #{tag}
                </a>
              ))
            }
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <button
              id="share-image"
              type="button"
              class="rounded-lg border border-purple-500/60 bg-purple-500/15 px-4 py-2 text-sm text-purple-200 transition hover:bg-purple-500/25 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400"
              >Share / copy link</button
            >
            <a
              href={image.src}
              class="text-xs text-zinc-400 underline underline-offset-4 hover:text-zinc-100"
              >Open original ↗</a
            >
          </div>
          <p
            id="share-status"
            role="status"
            aria-live="polite"
            class="mt-3 min-h-5 text-xs text-zinc-400"
          >
          </p>
          <p class="mt-8 text-xs break-all text-zinc-600">{canonical}</p>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>
<script>
  const originKey = "gallery-image-origin";
  const referrer = document.referrer ? new URL(document.referrer) : null;
  const isListing = (url: URL) =>
    url.origin === location.origin &&
    (url.pathname === "/gallery" ||
      url.pathname === "/gallery/" ||
      url.pathname.startsWith("/gallery/tag/"));
  const isDetail = (url: URL) =>
    url.origin === location.origin &&
    url.pathname.startsWith("/gallery/image/");
  if (referrer && isListing(referrer)) {
    sessionStorage.setItem(originKey, referrer.pathname + referrer.search);
  } else if (!referrer || !isDetail(referrer)) {
    sessionStorage.removeItem(originKey);
  }
  document.addEventListener("keydown", (event) => {
    if (
      event.altKey ||
      event.ctrlKey ||
      event.metaKey ||
      event.shiftKey ||
      event.defaultPrevented
    )
      return;
    const target = event.target;
    if (
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        /^(INPUT|TEXTAREA|SELECT|VIDEO)$/.test(target.tagName))
    )
      return;
    if (event.key === "Escape") {
      event.preventDefault();
      location.assign(sessionStorage.getItem(originKey) ?? "/gallery");
    } else if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      const link = document.querySelector<HTMLAnchorElement>(
        event.key === "ArrowLeft" ? '[rel="prev"]' : '[rel="next"]',
      );
      if (link) {
        event.preventDefault();
        location.assign(link.href);
      }
    }
  });
  const button = document.querySelector<HTMLButtonElement>("#share-image");
  const status = document.querySelector<HTMLElement>("#share-status");
  button?.addEventListener("click", async () => {
    const url =
      document.querySelector<HTMLLinkElement>("link[rel=canonical]")?.href ??
      window.location.href;
    const title = document.title.replace(" | Gallery | urandom.io", "");
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        if (status) status.textContent = "Shared.";
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError")
          return;
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      if (status) status.textContent = "Link copied to clipboard.";
    } catch {
      if (status) status.textContent = "Copy the link shown below.";
    }
  });
</script>
